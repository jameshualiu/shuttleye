rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // Users profile doc (as deployed before the match library)
    match /users/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid);
      allow update: if isMe(uid);
      allow delete: if false;

      // Videos subcollection
      match /videos/{videoId} {
        allow read: if isMe(uid);
        allow create: if isMe(uid);
        allow update: if isMe(uid);
        allow delete: if isMe(uid);
      }
    }

    // Match library. Written only by tools/library (Admin SDK), never by clients.
    match /matches/{id} {
      allow read: if signedIn()
        && (resource.data.status == "published" || isAdmin());
      allow write: if false;
    }

    match /players/{path=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /tournaments/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /library/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
