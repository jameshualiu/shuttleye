# Frontend environment variables — copy to .env.local and fill in real values.
# Do NOT commit the real .env.local.

# --- Firebase web app config ---
# Firebase console → Project settings → General → Your apps → SDK setup and
# configuration. These end up in the browser bundle, so they aren't secrets,
# but keep them out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Backend API ---
# Base URL for the Express API, including the /api prefix. Only needed when
# running `npm run dev` directly; docker-compose.yml sets this for you.
VITE_API_BASE_URL=http://localhost:3000/api

# --- Landing-page demo (optional) ---
# A demo clip, its analysis.json and an optional poster image. Leave them blank
# and the landing page shows no demo. For local dev, put the files in
# public/demo-local/ (gitignored) and use paths like /demo-local/clip.mp4.
VITE_DEMO_VIDEO_URL=
VITE_DEMO_ANALYSIS_URL=
VITE_DEMO_POSTER_URL=
